# Copy this file to .env and fill in the values before running docker compose up.

# -- Required ------------------------------------------------------------------
# No defaults. The application fails to start if either is unset.
# Generate with: openssl rand -hex 32
JWT_SECRET=
# 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Choose a strong password for the Postgres superuser
POSTGRES_PASSWORD=

# -- Database ------------------------------------------------------------------
# Unset in Docker: docker-compose.yml points the app at the db service. Set these
# only when running the backend outside the compose network.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# -- Email (SMTP) --------------------------------------------------------------
# Optional - needed only for password-reset emails. Compose defaults to MailHog,
# viewable at http://localhost:8025.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# -- Ollama (AI) ---------------------------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# -- App -----------------------------------------------------------------------
APP_BASE_URL=
APP_FRONTEND_URL=
# Set true when serving over HTTPS
COOKIE_SECURE=
